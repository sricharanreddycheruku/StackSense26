   }
  ],
  "version_regex": "(\\d{4}|\\d+(\\.\\d+)*)",
  "migrate": {
   "engine": "SQL Server",
   "detail": "the same SQL Server engine and T-SQL",
   "azure": {
    "tool": "Azure Database Migration Service or the Data Migration Assistant (DMA)",
    "url": "https://learn.microsoft.com/en-us/azure/dms/dms-overview"
   },
   "aws": {
    "tool": "AWS Database Migration Service",
    "url": "https://docs.aws.amazon.com/dms/latest/userguide/Welcome.html"
   },
   "gcp": {
    "tool": "Google Database Migration Service",
    "url": "https://cloud.google.com/database-migration/docs"
   }
  }
 },
