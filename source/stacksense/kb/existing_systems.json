[
 {
  "pattern": "entra|azure\\s*(ad|active\\s*directory)",
  "id": "entra_id",
  "kind": "identity",
  "effects": {
   "auth": {
    "prefer": "entra_id",
    "bonus": 35
   }
  },
  "integration": "Federate sign-in with {name} using OpenID Connect or SAML; keep {name} as the identity source of truth and map groups to roles.",
  "sources": [
   {
    "title": "Microsoft Entra documentation",
    "url": "https://learn.microsoft.com/en-us/entra/identity/"
   }
  ]
 },
 {
  "pattern": "^(?!.*\\b(azure|entra)\\b).*(active\\s*directory|\\bad\\s*ds\\b)",
  "id": "ad_ds",
  "kind": "identity",
  "effects": {
   "auth": {
    "prefer": "keycloak",
    "accept": [
     "entra_id"
    ],
    "bonus": 20,
    "reason": "federates the existing directory \"{input}\" over LDAP and Kerberos, so accounts and groups stay in it"
   }
  },
  "integration": "Keep {name} as the directory: connect it over LDAP/Kerberos (Keycloak user federation, Spring Security LDAP or ASP.NET Core Negotiate) and map its groups to roles; for cloud sign-in, sync it to Entra ID with Entra Connect.",
  "sources": [
   {
    "title": "Active Directory Domain Services overview",
    "url": "https://learn.microsoft.com/en-us/windows-server/identity/ad-ds/get-started/virtual-dc/active-directory-domain-services-overview"
   },
   {
    "title": "Keycloak Server Administration Guide: LDAP and Active Directory user federation",
    "url": "https://www.keycloak.org/docs/latest/server_admin/index.html"
   },
   {
    "title": "What is Microsoft Entra Connect",
    "url": "https://learn.microsoft.com/en-us/entra/identity/hybrid/connect/whatis-azure-ad-connect"
   }
  ]
 },
